# Copy to server/.env.cloud. This file is for the read-only cloud check only.
# Keep server/.env pointing to the current database until restore is verified.
# Paste the Supabase Connect > Session pooler URI. URL-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DB_SSL_MODE=verify-full
# Download the server root certificate from Supabase Database settings.
# Path is relative to server/. Never use rejectUnauthorized=false.
DB_SSL_CA_FILE=certs/supabase-ca.crt
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=10000
